{
  "name": "@deepseek-ai/dsh-electron",
  "productName": "DeepSeek Harness",
  "description": "Electron desktop shell: spawns the built dsh CLI (`web` profile) as a child process and loads its GUI in a native window",
  "version": "0.1.0-rc.5",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "license": "MIT",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\" && tsc -p tsconfig.json",
    "dev": "pnpm run build && electron .",
    "start": "electron .",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:^"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "typescript": "^6.0.3",
    "electron-builder": "^26.15.3"
  }
}
